PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/vu_studymate
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
# Free Gemini API key from Google AI Studio. Leave empty to run without AI
# (the /api/generate endpoint then returns 503). Never put it in the frontend.
GEMINI_API_KEY=
# Free models to try in order (comma-separated). If one is overloaded or
# retired, the API falls back to the next. All three are free-tier models.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
